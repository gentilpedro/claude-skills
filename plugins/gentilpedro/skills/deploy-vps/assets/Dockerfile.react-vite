# Imagem de produção da VPS para SPA React + Vite. Contexto = raiz do repositório:
#   docker build -f deploy/vps/Dockerfile --build-arg VITE_API_URL=... -t __APP__:1.2.3 .
FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Variáveis VITE_* entram no bundle e são PÚBLICAS: só URLs e flags, nunca segredo.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY deploy/vps/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
